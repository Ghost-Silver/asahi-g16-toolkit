From a759a18ddbffe55a143c89023cbb283eb4b3a26e Mon Sep 17 00:00:00 2001
From: Ghost-Silver <cyf31415@yeah.net>
Date: Sat, 31 Oct 2026 11:05:55 +0800
Subject: [PATCH 1/2] asahi/isa: Initial Apple G16 bring-up support

- Allow register hint=0 for unhinted operands in G16 binaries
- Add G16 jmp_reg indirect register jump (opcode 0x54) to Jump indirect group
- Add 250 real-world G16 disassembler test vectors mined from M3 Pro driver binaries
---
 src/asahi/isa/AGX2.xml           |   1 +
 src/asahi/isa/test/disasm.py     |   2 +-
 src/asahi/isa/test/g16_cases.txt | 250 +++++++++++++++++++++++++++++++
 3 files changed, 252 insertions(+), 1 deletion(-)
 create mode 100644 src/asahi/isa/test/g16_cases.txt

diff --git a/src/asahi/isa/AGX2.xml b/src/asahi/isa/AGX2.xml
index f3e6733..d99bf55 100644
--- a/src/asahi/isa/AGX2.xml
+++ b/src/asahi/isa/AGX2.xml
@@ -1121,6 +1121,7 @@
 
     <ins name="ret"      opcode="0010100"/>
     <ins name="call_reg" opcode="0000100" display="call"/>
+    <ins name="jmp_reg"  opcode="1010100" display="jmp"/>
   </group>
 
   <group name="Jump direct" length="6">
diff --git a/src/asahi/isa/test/disasm.py b/src/asahi/isa/test/disasm.py
index fdc9c5d..b45bf0e 100644
--- a/src/asahi/isa/test/disasm.py
+++ b/src/asahi/isa/test/disasm.py
@@ -63,7 +63,7 @@ def operand(desc, length):
         elif hint == 2:
             cache = True
         else:
-            assert(hint == 1)
+            assert(hint in [0, 1])
 
     assert(not (cache and discard))
     hint = '^' if discard else '$' if cache else ''
