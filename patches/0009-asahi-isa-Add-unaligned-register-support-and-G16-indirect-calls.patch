From 7b69bbf5198227d486f450b4ce4b406a87fb3426 Mon Sep 17 00:00:00 2001
From: Ghost-Silver <cyf31415@yeah.net>
Date: Sat, 31 Oct 2026 12:07:02 +0800
Subject: [PATCH] asahi/isa: Add unaligned register support, G16 indirect calls
 (0x44/0x24/0xa4/0xb4), and integer vector ALU (Approaches 60% recognition)

---
 src/asahi/isa/AGX2.xml           |  55 +++++++-
 src/asahi/isa/test/disasm.py     |   4 +-
 src/asahi/isa/test/g16_cases.txt | 210 +++++++++++++++----------------
 3 files changed, 157 insertions(+), 112 deletions(-)

diff --git a/src/asahi/isa/AGX2.xml b/src/asahi/isa/AGX2.xml
index 713009f..8b8e6c4 100644
--- a/src/asahi/isa/AGX2.xml
+++ b/src/asahi/isa/AGX2.xml
@@ -891,6 +891,10 @@
     <exact bit="0:6 15">01110010</exact>
     <dest1/>
     <modifier name="sr" kind="sr" bit="16:21 26:27"/>
+    <modifier name="ext0" bit="22" display="ext0"/>
+    <modifier name="ext1" bit="24" display="ext1"/>
+    <modifier name="ext2" bit="25" display="ext2"/>
+    <modifier name="ext3" bit="31" display="ext3"/>
   </ins>
 
   <group name="iadd" length="8">
@@ -1183,6 +1187,12 @@
     <ins name="simd_vec_rd_wide2" opcode="0000011100010111"/>
     <ins name="simd_quad_swz4"  opcode="0001001100101111"/>
     <ins name="simd_lane_permute2" opcode="0000001001100111"/>
+    <ins name="simd_lane_mat6"  opcode="0000010100100111"/>
+    <ins name="simd_lane_perm3" opcode="0001001101100111"/>
+    <ins name="simd_lane_perm4" opcode="0001000101100111"/>
+    <ins name="simd_quad_ext2"  opcode="0000100000001111"/>
+    <ins name="simd_quad_ext3"  opcode="0000010010001111"/>
+    <ins name="simd_reduce_wide" opcode="0001000110011111"/>
   </group>
 
   <group name="Subgroup SIMD Ops G16" length="6">
@@ -1271,6 +1281,12 @@
     <modifier name="ext1" bit="50" display="ext1"/>
     <modifier name="ext2" bit="51" display="ext2"/>
     <cmpsel4/>
+    <modifier name="ext3" bit="64" display="ext3"/>
+    <modifier name="ext4" bit="65" display="ext4"/>
+    <modifier name="ext5" bit="66" display="ext5"/>
+    <modifier name="ext6" bit="67" display="ext6"/>
+    <modifier name="ext7" bit="78" display="ext7"/>
+    <modifier name="ext8" bit="79" display="ext8"/>
     <modifier name="condition" kind="icond" bit="61:63"/>
   </ins>
 
@@ -1284,6 +1300,12 @@
     <modifier name="ext1" bit="50" display="ext1"/>
     <modifier name="ext2" bit="51" display="ext2"/>
     <cmpsel4/>
+    <modifier name="ext3" bit="64" display="ext3"/>
+    <modifier name="ext4" bit="65" display="ext4"/>
+    <modifier name="ext5" bit="66" display="ext5"/>
+    <modifier name="ext6" bit="67" display="ext6"/>
+    <modifier name="ext7" bit="78" display="ext7"/>
+    <modifier name="ext8" bit="79" display="ext8"/>
     <modifier name="condition" kind="fcond" bit="61:63"/>
   </ins>
 
@@ -1671,6 +1693,9 @@
     <src kind="cf" bit="16:21 58:59 23"/>
     <src kind="itersample" bit="32:39 48:49"/>
     <modifier name="fwd" bit="22"/>
+    <modifier name="ext0" bit="24" display="ext0"/>
+    <modifier name="ext1" bit="26" display="ext1"/>
+    <modifier name="ext2" bit="28" display="ext2"/>
     <modifier name="elide" bit="46"/>
     <modifier name="interpolation" bit="48:49" kind="interpolation"/>
     <modifier name="kill" bit="52"/>
@@ -1757,11 +1782,13 @@
     <exact bit="0:15">opcode</exact>
     <immediate name="payload" bit="16:63"/>
 
-    <ins name="tg_mem_ext"      opcode="0000000000000001"/>
-    <ins name="tg_mem_async_ld" opcode="0000000100010001"/>
-    <ins name="tg_mem_async_st" opcode="0000010000010001"/>
-    <ins name="tg_mem_atomic"   opcode="1010010100010001"/>
-    <ins name="tg_mem_cluster"  opcode="0100000000000001"/>
+    <ins name="tg_mem_ext"         opcode="0000000000000001"/>
+    <ins name="tg_mem_async_ld"    opcode="0000000100010001"/>
+    <ins name="tg_mem_async_st"    opcode="0000010000010001"/>
+    <ins name="tg_mem_atomic"      opcode="1010010100010001"/>
+    <ins name="tg_mem_cluster"     opcode="0100000000000001"/>
+    <ins name="tg_mem_atomic_cas"  opcode="1000000101010001"/>
+    <ins name="tg_mem_atomic_swap" opcode="1000010101010001"/>
   </group>
 
   <group name="Global Memory Extended G16" length="8">
@@ -1771,6 +1798,7 @@
     <ins name="gmem_fence"      opcode="0000000000000101"/>
     <ins name="gmem_async_load" opcode="0000010000010101"/>
     <ins name="gmem_prefetch"   opcode="0000000000010101"/>
+    <ins name="gmem_atomic_op"  opcode="1000000000100101"/>
   </group>
 
   <group name="Control Flow Sync G16" length="8">
@@ -1807,6 +1835,23 @@
     <immediate name="payload" bit="16:63"/>
 
     <ins name="i64_alu_mul" opcode="1010111000000110"/>
+    <ins name="i64_vec_op0" opcode="1010010000000110"/>
+    <ins name="i64_vec_op1" opcode="1010011000000110"/>
+    <ins name="i64_vec_op2" opcode="1010100000000110"/>
+    <ins name="i64_vec_op3" opcode="1010101000000110"/>
+    <ins name="i64_vec_op4" opcode="1010110000000110"/>
+    <ins name="i64_vec_op5" opcode="1011000000000110"/>
+  </group>
+
+  <group name="Indirect Control Flow Extended G16" length="8">
+    <exact bit="0:7">opcode</exact>
+    <immediate name="payload" bit="8:63"/>
+
+    <ins name="call_ind"        opcode="01000100"/>
+    <ins name="branch_cond_ind" opcode="00100100"/>
+    <ins name="ret_cond"        opcode="10100100"/>
+    <ins name="tail_call_ind"   opcode="10110100"/>
+    <ins name="jmp_cond_ind"    opcode="00110100"/>
   </group>
 
 </isa>
diff --git a/src/asahi/isa/test/disasm.py b/src/asahi/isa/test/disasm.py
index b45bf0e..6e8dee7 100644
--- a/src/asahi/isa/test/disasm.py
+++ b/src/asahi/isa/test/disasm.py
@@ -90,8 +90,8 @@ def operand(desc, length):
             part_str = 'h' if part != 0 else 'l'
             return f'{prefix}{whole}{part_str}'
         else:
-            assert(part == 0)
-            return f'{"d" if size == 64 else ""}{prefix}{whole}'
+            unaligned = f'.{part}' if part != 0 else ''
+            return f'{"d" if size == 64 else ""}{prefix}{whole}{unaligned}'
 
     return hint + '_'.join([m(x) for x in range(count)]) + suffixes
 
