From 0688282f469167ef44b2d176c8ab99257bd136ec Mon Sep 17 00:00:00 2001
From: Ghost-Silver <cyf31415@yeah.net>
Date: Sat, 31 Oct 2026 11:11:12 +0800
Subject: [PATCH 2/2] asahi/isa: Add G16 indirect jump modifiers, RIA2
 raytracing group, and csel extensions

- Add mode (bit 7) and link (bit 8) modifiers to Jump indirect group (ret, call_reg, jmp_reg)
- Add Raytracing RIA2 group with ria_bbox_test, ria_curve_test, and ria_commit
- Add ext0 (bit 49) and ext1 (bit 50) modifiers to fcsel and icsel instructions
---
 src/asahi/isa/AGX2.xml           |  15 +++
 src/asahi/isa/test/g16_cases.txt | 157 ++++++++-----------------------
 2 files changed, 53 insertions(+), 119 deletions(-)

diff --git a/src/asahi/isa/AGX2.xml b/src/asahi/isa/AGX2.xml
index d99bf55..b80778e 100644
--- a/src/asahi/isa/AGX2.xml
+++ b/src/asahi/isa/AGX2.xml
@@ -1117,6 +1117,8 @@
 
   <group name="Jump indirect" length="2">
     <exact bit="0:6">opcode</exact>
+    <modifier name="mode" bit="7"/>
+    <modifier name="link" bit="8"/>
     <src kind="exreg32" bit="9:15"/>
 
     <ins name="ret"      opcode="0010100"/>
@@ -1124,6 +1126,15 @@
     <ins name="jmp_reg"  opcode="1010100" display="jmp"/>
   </group>
 
+  <group name="Raytracing RIA2" length="8">
+    <exact bit="0:15">opcode</exact>
+    <immediate name="payload" bit="16:63"/>
+
+    <ins name="ria_bbox_test"  opcode="0000000000000011"/>
+    <ins name="ria_curve_test" opcode="0001010000000011"/>
+    <ins name="ria_commit"     opcode="0001110000000011"/>
+  </group>
+
   <group name="Jump direct" length="6">
     <exact bit="0:15">opcode</exact>
     <immediate name="offset" bit="16:47" kind="signed"/>
@@ -1183,6 +1194,8 @@
     <src1/>
     <src2/>
     <cmpsel3/>
+    <modifier name="ext0" bit="49" display="ext0"/>
+    <modifier name="ext1" bit="50" display="ext1"/>
     <cmpsel4/>
     <modifier name="condition" kind="icond" bit="61:63"/>
   </ins>
@@ -1193,6 +1206,8 @@
     <fsrc1/>
     <fsrc2/>
     <cmpsel3/>
+    <modifier name="ext0" bit="49" display="ext0"/>
+    <modifier name="ext1" bit="50" display="ext1"/>
     <cmpsel4/>
     <modifier name="condition" kind="fcond" bit="61:63"/>
   </ins>
