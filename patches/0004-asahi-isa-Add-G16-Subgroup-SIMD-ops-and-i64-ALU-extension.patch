+    <ins name="simd_reduce"    opcode="0000000110011111"/>
+  </group>
+
+  <group name="Integer ALU Extended G16" length="6">
+    <exact bit="0:15">opcode</exact>
+    <immediate name="payload" bit="16:47"/>
+
+    <ins name="i64_alu_ext" opcode="0000000000000110"/>
+  </group>
+
   <group name="Jump direct" length="6">
     <exact bit="0:15">opcode</exact>
     <immediate name="offset" bit="16:47" kind="signed"/>
