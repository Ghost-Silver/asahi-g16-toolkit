index 90f8ba5..917631e 100644
--- a/src/asahi/isa/AGX2.xml
+++ b/src/asahi/isa/AGX2.xml
@@ -1143,6 +1143,25 @@
     <ins name="simd_vec_wr" opcode="0000001000010111"/>
   </group>
 
+  <group name="Subgroup SIMD Ops G16" length="6">
+    <exact bit="0:15">opcode</exact>
+    <immediate name="payload" bit="16:47"/>
+
+    <ins name="simd_ballot"    opcode="0000000100001111"/>
+    <ins name="simd_shuffle"   opcode="0000011000001111"/>
+    <ins name="simd_broadcast" opcode="0000010100001111"/>
