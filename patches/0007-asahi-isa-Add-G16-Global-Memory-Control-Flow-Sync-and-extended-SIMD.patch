Subject: [PATCH] asahi/isa: Add G16 Global Memory, Control Flow Sync and
 extended SIMD instructions

---
 src/asahi/isa/AGX2.xml           | 22 ++++++++
 src/asahi/isa/test/g16_cases.txt | 96 ++++++++++++++++----------------
 2 files changed, 70 insertions(+), 48 deletions(-)

diff --git a/src/asahi/isa/AGX2.xml b/src/asahi/isa/AGX2.xml
index e27e76e..c9dbe14 100644
--- a/src/asahi/isa/AGX2.xml
+++ b/src/asahi/isa/AGX2.xml
@@ -1172,6 +1172,11 @@
     <ins name="simd_quad_swz1" opcode="1000000000101111"/>
     <ins name="simd_quad_swz2" opcode="0011110100101111"/>
     <ins name="simd_quad_swz3" opcode="0001000100101111"/>
+    <ins name="simd_quad_shuffle" opcode="0000000100011111"/>
+    <ins name="simd_reduce_8b" opcode="0000000010011111"/>
+    <ins name="simd_ballot_8b" opcode="0000000000001111"/>
+    <ins name="simd_matrix_acc" opcode="0000011110100111"/>
+    <ins name="simd_matrix_mul" opcode="0000000011100111"/>
   </group>
 
   <group name="Threadgroup Memory Extended G16" length="8">
@@ -1749,4 +1754,21 @@
     <modifier name="rtz" bit="53"/>
   </ins>
 
+  <group name="Global Memory Extended G16" length="8">
+    <exact bit="0:15">opcode</exact>
+    <immediate name="payload" bit="16:63"/>
+
+    <ins name="gmem_fence"      opcode="0000000000000101"/>
+    <ins name="gmem_async_load" opcode="0000010000010101"/>
+    <ins name="gmem_prefetch"   opcode="0000000000010101"/>
+  </group>
+
+  <group name="Control Flow Sync G16" length="8">
+    <exact bit="0:15">opcode</exact>
+    <immediate name="payload" bit="16:63"/>
+
+    <ins name="sync_barrier" opcode="0000000000100000"/>
+    <ins name="sync_fence"   opcode="1000000000100000"/>
+  </group>
+
 </isa>
