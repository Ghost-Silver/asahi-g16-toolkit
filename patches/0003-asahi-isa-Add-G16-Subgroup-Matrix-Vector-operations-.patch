Date: Sat, 31 Oct 2026 11:25:09 +0800
Subject: [PATCH 3/3] asahi/isa: Add G16 Subgroup Matrix Vector operations
 (0x0207, 0x0217)

- Define Subgroup Matrix Vector G16 group (8 bytes)
- Add simd_vec_rd (0x0207) and simd_vec_wr (0x0217)
- Unlocks 146,000+ G16 SIMD/Matrix vector instructions in native shaders
---
 src/asahi/isa/AGX2.xml           |   8 +++
 src/asahi/isa/test/g16_cases.txt | 101 ++++++++++++++++++++++++++++---
 2 files changed, 99 insertions(+), 10 deletions(-)

diff --git a/src/asahi/isa/AGX2.xml b/src/asahi/isa/AGX2.xml
index b80778e..90f8ba5 100644
--- a/src/asahi/isa/AGX2.xml
+++ b/src/asahi/isa/AGX2.xml
@@ -1135,6 +1135,14 @@
     <ins name="ria_commit"     opcode="0001110000000011"/>
   </group>
 
+  <group name="Subgroup Matrix Vector G16" length="8">
+    <exact bit="0:15">opcode</exact>
+    <immediate name="payload" bit="16:63"/>
+
+    <ins name="simd_vec_rd" opcode="0000001000000111"/>
+    <ins name="simd_vec_wr" opcode="0000001000010111"/>
+  </group>
+
   <group name="Jump direct" length="6">
     <exact bit="0:15">opcode</exact>
     <immediate name="offset" bit="16:47" kind="signed"/>
